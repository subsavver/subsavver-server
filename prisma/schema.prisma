generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  cancelAt  DateTime?
  stripeId  String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User[]

  @@map("subscription")
}

model Category {
  id                  String                @id @default(uuid())
  name                String                @unique
  description         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  subscriptionService SubscriptionService[]
  subscriptions       UserSubscription[]

  @@map("category")
}

model SubscriptionService {
  id         String             @id @default(uuid())
  name       String             @unique
  logo       String
  company    String
  createdBy  String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  categoryId String?
  category   Category?          @relation(fields: [categoryId], references: [id])
  users      UserSubscription[]

  @@map("subscription_service")
}

model UserSubscription {
  id               String              @id @default(uuid())
  userId           String
  serviceId        String
  planName         String?
  amount           Float
  renewalDate      DateTime
  isActive         Boolean             @default(true)
  notes            String?
  lastPaymentDate  DateTime?
  nextPaymentDate  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  categoryId       String?
  remindBeforeDays Int                 @default(3)
  payment          Payment[]
  reminders        Reminder[]
  spendingLogs     SpendingHistory[]
  category         Category?           @relation(fields: [categoryId], references: [id])
  service          SubscriptionService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscription")
}

model Reminder {
  id             String           @id @default(uuid())
  userId         String
  subscriptionId String
  notifyAt       DateTime?
  sent           Boolean          @default(false)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  channel        ReminderChannel  @default(EMAIL)
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder")
}

model SpendingHistory {
  id             String           @id @default(uuid())
  userId         String
  subscriptionId String
  amount         Float
  action         String
  date           DateTime         @default(now())
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spending_history")
}

model UserAnalytics {
  id                 String   @id @default(uuid())
  userId             String   @unique
  totalSubscriptions Int      @default(0)
  totalSpent         Float    @default(0)
  estimatedSavings   Float    @default(0)
  lastCalculated     DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_analytic")
}

model Payment {
  id              String           @id @default(uuid())
  subscriptionId  String
  userId          String
  amount          Float
  currency        Currency         @default(USD)
  paymentStatus   PaymentStatus    @default(PENDING)
  paymentProvider PaymentProvider  @default(STRIPE)
  isPaid          Boolean          @default(false)
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  subscription    UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment")
}

model User {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  emailVerified   Boolean            @default(false)
  image           String?            @default("")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now())
  banned          Boolean?           @default(false)
  banReason       String?            @default("")
  banExpires      DateTime?          @default(now())
  timezone        String             @default("UTC")
  role            UserRole           @default(USER)
  planId          String?            @default("")
  subscriptionId  String?            @default("")
  imagePublicId   String?            @default("")
  payment         Payment[]
  reminder        Reminder[]
  spendingHistory SpendingHistory[]
  userAnalytics   UserAnalytics?
  subscriptions   UserSubscription[]
  account         Account[]
  session         Session[]
  plan            Plan?              @relation(fields: [planId], references: [id], onDelete: Cascade)
  Subscription    Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Plan {
  id            String         @id @default(uuid())
  name          String         @unique
  price         Float
  currency      Currency       @default(USD)
  interval      String         @default("month")
  features      Json
  type          PlanType       @default(FREE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isActive      Boolean        @default(true)
  includes      Json?
  isPopular     Boolean        @default(false)
  subscriptions Subscription[]
  user          User[]

  @@map("plan")
}

model Session {
  id             String   @id @default(uuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@map("verification")
}

enum Currency {
  USD
  EUR
  GBP
  JPY
  AUD
  CAD
  CHF
  CNY
  INR
  NZD
  SGD
  ZAR
  HKD
  NOK
  SEK
  DKK
  MXN
  BRL
  RUB
  KRW
  AED
  SAR
  BDT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  BRAINTREE
  ADYEN
  TWO_CHECKOUT
  WORLDPAY
  PAYONEER
  APPLE_PAY
  GOOGLE_PAY
  ALIPAY
  WECHAT_PAY
  WISE
}

enum ReminderChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum UserRole {
  USER
  ADMIN
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
  CUSTOM
}

enum PlanType {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PENDING
}
